<table>
    <tbody>
    {% for row in table %}
        <tr>
            <td>
                <table>
                    <thead>
                        <tr>
                            <td> </td>
                            <th> Array </th>
                            <th> Chunk </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th> Bytes </th>
                            <td> {{ row[0].nbytes | memory_repr }} </td>
                            <td> {{ row[0].cbytes | memory_repr }} </td>
                        </tr>
                        <tr>
                            <th> Shape </th>
                            <td> {{ row[0].shape }} </td>
                            <td> {{ row[0].chunksize }} </td>
                        </tr>
                        <tr>
                            <th> Count </th>
                            <td> {{ 1 }} </td>
                            <td> {{ row[0].npartitions }} Chunks </td>
                        </tr>
                        <tr>
                            <th> Type </th>
                            <td> {{ row[0].dtype }} </td>
                            <td> {{ arrtype }} </td>
                        </tr>
                    </tbody>
                </table>
            </td>
            <td>
            {{row[1]}}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
